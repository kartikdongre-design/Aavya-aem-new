{
  "name": "@adobe/aem-boilerplate",
  "private": true,
  "version": "1.3.0",
  "description": "Starter project for Adobe Helix",
  "scripts": {
    "start": "npm run dev",
    "dev": "bash ./tools/dev-shop.sh",
    "dev:aem": "npx @adobe/aem-cli up --no-open --forward-browser-logs --html-folder . --html-mount /",
    "dev:shop": "npm run dev",
    "install:shop": "npm install --prefix ecommerce-react",
    "build:shop": "npm run build --prefix ecommerce-react",
    "preview:urls": "bash ./tools/preview-urls.sh",
    "content:pull:preview": "bash ./tools/pull-aem-content.sh preview /content/index",
    "content:pull:live": "bash ./tools/pull-aem-content.sh live /content/index",
    "content:verify:no-placeholder": "bash ./tools/verify-no-placeholder.sh preview /",
    "verify:blocks": "bash ./tools/verify-block-mapping.sh",
    "prepush:check": "npm run lint && npm run verify:blocks && npm run content:verify:no-placeholder && npm run preview:urls",
    "lint:js": "eslint .",
    "lint:css": "stylelint \"blocks/**/*.css\" \"styles/*.css\"",
    "lint": "npm run lint:js && npm run lint:css",
    "lint:fix": "npm run lint:js -- --fix && npm run lint:css -- --fix"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adobe/aem-boilerplate.git"
  },
  "author": "Adobe",
  "license": "Apache License 2.0",
  "bugs": {
    "url": "https://github.com/adobe/aem-boilerplate/issues"
  },
  "homepage": "https://github.com/adobe/aem-boilerplate#readme",
  "devDependencies": {
    "@babel/eslint-parser": "7.28.6",
    "eslint": "8.57.1",
    "eslint-config-airbnb-base": "15.0.0",
    "eslint-plugin-import": "2.32.0",
    "stylelint": "17.6.0",
    "stylelint-config-standard": "40.0.0"
  }
}
